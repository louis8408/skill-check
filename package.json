{
  "name": "skill-check",
  "version": "0.4.1",
  "description": "Warns when an AI agent skill is used while out of date. Reference checker for the SKILL.md metadata.version / metadata.source convention.",
  "type": "module",
  "bin": {
    "skill-check": "bin/skill-check.mjs"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "bin",
    "plugin/dist",
    "CONVENTION.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:architecture": "vitest run tests/architecture",
    "test:codex": "vitest run --config vitest.codex.config.ts",
    "coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run coverage"
  },
  "keywords": [
    "codex",
    "agent-skills",
    "claude-code",
    "skills",
    "version",
    "hooks"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
